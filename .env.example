# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/app/apikey)
# Copy this file to .env.local:
#   cp .env.example .env.local
# And insert your configuration below:
GEMINI_API_KEY=your_gemini_api_key_here

# Platform Administration Credentials (Guards /admin monitoring suite)
ADMIN_USERNAME=shuhrat3
ADMIN_EMAIL=admin@ieltsmentor.ai
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SESSION_SECRET=your_random_cryptographic_hmac_secret_here

# Database Configuration (Optional: Turso LibSQL or Supabase)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your_turso_token
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Auth, Deep-Links & Distributed Rate Limiting (Optional)
# TEACHER_ACCESS_CODE=your_school_invite_code
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Standalone Monetization & P2P Billing Overrides (Optional)
# PRO_MONTHLY_PRICE_UZS=49000
# PRO_MONTHLY_PRICE_USD=9
# PRO_QUARTERLY_PRICE_UZS=119000
# PRO_QUARTERLY_PRICE_USD=22
# SCHOOL_SEAT_PRICE_UZS=25000
# SCHOOL_SEAT_PRICE_USD=2
# BILLING_P2P_CARD_NUMBER=8600000000000000
# BILLING_P2P_CARD_HOLDER=Your Official Account Name
# BILLING_P2P_BANK_NAME=Humo / Uzcard

# Support & Notifications (Optional)
# NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
# NEXT_PUBLIC_SUPPORT_TELEGRAM=@your_support_handle
# TELEGRAM_ADMIN_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_ADMIN_CHAT_ID=your_telegram_admin_chat_id
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM="IELTS Mentor AI <no-reply@yourdomain.com>"

# Automated Payment Gateway Webhooks (Optional)
# CLICK_SERVICE_ID=your_click_service_id
# CLICK_SECRET_KEY=your_click_secret_key
# PAYME_MERCHANT_KEY=your_payme_merchant_key
# LEMON_SQUEEZY_WEBHOOK_SECRET=your_lemonsqueezy_webhook_secret

# Local Development Only (Never enable in production)
# ALLOW_MOCK_EVALUATION=false
